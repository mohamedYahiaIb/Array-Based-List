#include <iostream>
using namespace std;

class arrayList {
    int *arr;
    int maxSize;
    int length;
  public:
    arrayList(int size = 20) {
        if(size < 0) {
            size = 10;
        } else {
            maxSize = size;
        }
        length = 0;
        arr = new int[maxSize];
    }
    
    bool isEmpty() {
        return length == 0;
    }
    
    bool isFull() {
        return length == maxSize;
    }
    
    int getSize() {
        return length;
    }
    
    void insertAtPos(int pos, int element) {
        if(isFull()) {
            cout << "The list is full";
        } else if (pos < 0 || pos > length) {
            cout << "Out of range";
        } else {
            for (int i = length; i > pos; i--) {
                arr[i] = arr[i - 1];
            }
            arr[pos] = element;
            length++;
        }
    }
    
    void insertAtEnd(int element) {
        if(isFull()) {
            cout << "The list is full";
        } else {
            arr[length] = element;
            length++;
        }
    }
    
    void deleteAtPos(int pos) {
        if(isEmpty()) {
            cout << "The list is empty";
        } else if (pos < 0 || pos > length) {
            cout << "Out of range";
        } else {
            for (int i = pos; i < length; i++) {
                arr[i] = arr[i + 1];
            }
            length--;
        }
    }
    
    int search(int element) {
        for (int i = 0; i < length; i++) {
            if (arr[i] == element) {
                return i;
            }
        }
        return -1;
    }
    
    void insertNoDuplicate(int element) {
        if (search(element) == -1) {
            insertAtEnd(element);
        } else {
            cout << "This element is already in the list" << endl;
        }
    }
    
    int getElement(int pos) {
        if (pos < 0 || pos > length) {
            cout << "Out of range";
        } else {
        return arr[pos];
        }
    }
    
    void updateAt(int pos, int element) {
        if(isEmpty()) {
            cout << "List is empty";
        } else {
            arr[pos] = element;
        }
    }
    
    void clear() {
        length = 0;
    }
    
    void display() {
        if(isEmpty()) {
            cout << "List is empty";
        } else {
            cout << "[ ";
            for (int i= 0; i < length; i++) {
                cout << arr[i] << " ";
            }
            cout << "]" << endl;
        }
        
    }
    
    ~arrayList() {
        delete []arr;
    }
    
    
};

int main() {
    arrayList arr(20);
    
    arr.insertAtEnd(10);
    arr.insertAtEnd(20);
    arr.insertAtEnd(30);
    arr.insertAtEnd(40);
    arr.insertAtEnd(50);
    
    arr.display();
    
    arr.insertNoDuplicate(99);
    
    arr.insertAtPos(4, 33);
    
    arr.display();
    
    arr.updateAt(0, 69);
    
    arr.display();
    
    arr.deleteAtPos(0);
    
    arr.display();
    
    cout << arr.search(20);
    
    cout << endl;
    
    cout << arr.getSize();
    
    

    return 0;
}
